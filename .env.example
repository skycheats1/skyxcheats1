PORT=5000
# Shared secret between the PHP admin panel and this API (make it long & random)
ADMIN_API_KEY=change-this-to-a-long-random-string
# imgbb API key -> https://api.imgbb.com/
IMGBB_API_KEY=your_imgbb_api_key
# Firebase Admin SDK: path to the service-account JSON you download from
# Firebase Console > Project settings > Service accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_PROJECT_ID=zelve-store
# Allowed origins for CORS (comma separated)
CORS_ORIGINS=http://localhost:8000
